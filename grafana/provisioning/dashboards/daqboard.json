    },
    {
      "id": 6,
      "type": "stat",
      "title": "Ingest losses (all nodes)",
      "datasource": {
        "type": "influxdb",
        "uid": "PF6CD3C7EE64CF7D1"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "PF6CD3C7EE64CF7D1"
          },
          "query": "from(bucket: \"waveform_1s\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"daq2_ingest\")\n  |> filter(fn: (r) => r._field == \"gap_frames\" or r._field == \"invalid_time\" or r._field == \"mqtt_drops\" or r._field == \"buffer_drop_lines\" or r._field == \"write_errors\")\n  |> sum()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "unit": "none",
          "displayName": "${__field.labels._field}"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "description": "Totals over the dashboard time range, from daq2-ingest's stats. All should be 0."
    },
