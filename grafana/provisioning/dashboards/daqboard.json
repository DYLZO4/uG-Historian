    {
      "id": 8,
      "type": "trend",
      "title": "Voltage",
      "datasource": {
        "type": "influxdb",
        "uid": "PF6CD3C7EE64CF7D1"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "PF6CD3C7EE64CF7D1"
          },
          "query": "base = from(bucket: \"waveform\")\n  |> range(start: -10s)\n  |> filter(fn: (r) => r._measurement == \"voltage\" and r.node_id == \"${node_id}\")\nstop = (base |> last() |> group() |> min(column: \"_time\") |> findRecord(fn: (key) => true, idx: 0))._time\nstart = time(v: int(v: stop) - 100000000)\nbase\n  |> filter(fn: (r) => r._time > start and r._time <= stop)\n  |> group(columns: [\"node_id\"])\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> sort(columns: [\"_time\"])\n  |> map(fn: (r) => ({\n      t_ms: float(v: int(v: r._time) - int(v: start)) / 1000000.0,\n      phase_a: float(v: r.a) / 1000.0,\n      phase_b: float(v: r.b) / 1000.0,\n      phase_c: float(v: r.c) / 1000.0\n    }))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "showPoints": "never",
            "fillOpacity": 0,
            "axisLabel": ""
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "volt"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "t_ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "displayName",
                "value": "time"
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "t_ms",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "description": "The node's newest ~100 ms at the full ~30 kHz, from the waveform bucket. Ignores the dashboard time range."
    },
