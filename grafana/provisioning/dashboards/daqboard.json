{
  "uid": "daqboard",
  "title": "DAQboard",
  "tags": [
    "microgrid"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "node_id",
        "label": "node_id",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "PF6CD3C7EE64CF7D1"
        },
        "query": "import \"influxdata/influxdb/schema\"\nunion(tables: [\n  schema.tagValues(bucket: \"telemetry\", tag: \"node_id\"),\n  schema.tagValues(bucket: \"waveform\", tag: \"node_id\")\n])\n  |> group()\n  |> unique()\n  |> sort()",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Status",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Node Status",
      "datasource": {
        "type": "influxdb",
        "uid": "PF6CD3C7EE64CF7D1"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "PF6CD3C7EE64CF7D1"
          },
          "query": "union(tables: [\n  from(bucket: \"telemetry\")\n    |> range(start: -1h)\n    |> filter(fn: (r) => r._measurement == \"mqtt_consumer\" and r.node_id == \"${node_id}\" and r._field == \"dt_ns\")\n    |> last() |> keep(columns: [\"_time\"]),\n  from(bucket: \"waveform\")\n    |> range(start: -1h)\n    |> filter(fn: (r) => r._measurement == \"daq2_packet\" and r.node_id == \"${node_id}\" and r._field == \"sequence\")\n    |> last() |> keep(columns: [\"_time\"])\n])\n  |> group()\n  |> max(column: \"_time\")\n  |> map(fn: (r) => ({_time: r._time, _value: float(v: uint(v: now()) - uint(v: r._time)) / 1000000000.0}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 30,
                "result": {
                  "text": "online",
                  "color": "green"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 30,
                "to": 1000000000000000.0,
                "result": {
                  "text": "offline",
                  "color": "red"
                }
              }
            }
          ],
          "noValue": "offline"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "description": "Online if the node's newest point on either path (full-rate DAQ2 or 5 s JSON snapshots) is less than 30 s old."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "PTP",
      "datasource": {
        "type": "influxdb",
        "uid": "PF6CD3C7EE64CF7D1"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "PF6CD3C7EE64CF7D1"
          },
          "query": "union(tables: [\n  from(bucket: \"waveform\")\n    |> range(start: -5m)\n    |> filter(fn: (r) => r._measurement == \"daq2_packet\" and r.node_id == \"${node_id}\" and r._field == \"locked\")\n    |> last() |> map(fn: (r) => ({_time: r._time, _value: float(v: r._value)})),\n  from(bucket: \"telemetry\")\n    |> range(start: -5m)\n    |> filter(fn: (r) => r._measurement == \"mqtt_consumer\" and r.node_id == \"${node_id}\" and r._field == \"sync\")\n    |> last() |> map(fn: (r) => ({_time: r._time, _value: float(v: r._value)}))\n])\n  |> group()\n  |> sort(columns: [\"_time\"])\n  |> last()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "locked",
                  "color": "green"
                },
                "0": {
                  "text": "unlocked",
                  "color": "red"
                }
              }
            }
          ],
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "description": "The node's PTP servo lock state, from its newest DAQ2 packet or JSON burst."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Full-rate frames/s",
      "datasource": {
        "type": "influxdb",
        "uid": "PF6CD3C7EE64CF7D1"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "PF6CD3C7EE64CF7D1"
          },
          "query": "from(bucket: \"waveform_1s\")\n  |> range(start: -1m)\n  |> filter(fn: (r) => r._measurement == \"voltage\" and r.node_id == \"${node_id}\" and r._field == \"frames\")\n  |> last()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 29900
              }
            ]
          },
          "mappings": [],
          "unit": "none",
          "noValue": "DAQ2 off"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "description": "Frames stored in the last complete second. ~30048 when the node publishes DAQ2 and nothing is lost."
    },
