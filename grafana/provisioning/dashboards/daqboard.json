          "query": "import \"strings\"\nfrom(bucket: \"waveform_1s\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"voltage\" and r.node_id == \"${node_id}\")\n  |> filter(fn: (r) => r._field == \"a_rms\" or r._field == \"b_rms\" or r._field == \"c_rms\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: true)\n  |> map(fn: (r) => ({r with _field: \"phase_\" + strings.substring(v: r._field, start: 0, end: 1)}))\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])"
        }
